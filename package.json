{
  "name": "auto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto — remote control for Cursor's agent, over web and Telegram",
  "scripts": {
    "start": "node src/server/index.mjs --host=0.0.0.0 --port=4331",
    "dev": "node src/server/index.mjs --host=127.0.0.1 --port=4340 --no-telegram",
    "supervise": "node scripts/supervise.mjs",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1 -Uninstall",
    "skills:install": "node scripts/install-skills.mjs",
    "test": "node scripts/test.mjs",
    "wiki": "wiki",
    "wiki:ingest": "wiki ingest --all -y",
    "wiki:query": "wiki query",
    "wiki:lint": "wiki lint --skip-llm"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "llm-wiki": "^0.1.3",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  }
}

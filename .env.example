# Auto LLM provider: claude (default Anthropic login) | kimi
AUTO_PROVIDER=kimi

# coding   = Kimi Code membership / subscription (default) — api.kimi.com/coding
# platform = pay-per-token Open Platform — api.moonshot.ai (needs balance)
AUTO_KIMI_MODE=coding

# oauth = use ~/.kimi login from `npm run kimi:login` (default)
# key   = use KIMI_CODE_API_KEY from this file
AUTO_KIMI_AUTH=oauth

# Optional Kimi Code console key (subscription quota), if not using oauth:
# KIMI_CODE_API_KEY=

# Only for AUTO_KIMI_MODE=platform (pay-per-token):
# KIMI_API_KEY=
# MOONSHOT_API_KEY=

# Optional model override (defaults: k3-256k for coding, kimi-k3[1m] for platform)
# AUTO_MODEL=k3-256k

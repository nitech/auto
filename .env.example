# Auto LLM provider: claude (default Anthropic login) | kimi
AUTO_PROVIDER=kimi

# platform = pay-per-token Open Platform (https://platform.kimi.ai/console/api-keys)
# coding   = Kimi Code subscription console key (https://www.kimi.com/code)
AUTO_KIMI_MODE=platform

# Required when AUTO_PROVIDER=kimi
KIMI_API_KEY=

# Optional model override (defaults: kimi-k3[1m] for platform, k3[1m] for coding)
# AUTO_MODEL=kimi-k3[1m]
